# =============================================================================
# Haedok AI — 환경변수 예시
# 이 파일을 복사해서 .env 로 사용하세요: cp .env.example .env
# .env 는 절대 커밋하지 마세요.
# =============================================================================

# -----------------------------------------------------------------------------
# 앱 공통
# -----------------------------------------------------------------------------
# 기본값(미설정 시)은 안전한 production. 로컬 개발은 반드시 development를 명시하세요.
APP_ENV=development          # development | production
# 안전한 랜덤 키 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
# production에서 기본값(change-me)/빈 값이면 서버 기동이 실패합니다.
APP_SECRET_KEY=              # Refresh Token HMAC 해시 키
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_CLIENT_URL=http://localhost:3000  # OAuth 로그인 완료 후 리다이렉트 URL
APP_ADMIN_URL=http://localhost:3001/admin  # 관리자 OAuth 로그인 완료 후 리다이렉트 URL

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost       # Docker 사용 시: postgres
POSTGRES_PORT=5432
POSTGRES_DB=haedok
POSTGRES_USER=haedok
POSTGRES_PASSWORD=

# SQLAlchemy DSN (자동 조합 가능하지만 명시 가능)
# DATABASE_URL=postgresql+asyncpg://haedok:password@localhost:5432/haedok

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# 안전한 랜덤 키 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=              # JWT HS256 서명 키 (APP_SECRET_KEY 와 별도 관리)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# OAuth — Google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth — Kakao
# -----------------------------------------------------------------------------
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------
OCR_ENGINE=google_vision      # google_vision | paddle_ocr
GOOGLE_VISION_API_KEY=        # OCR_ENGINE=google_vision 일 때 필수
# PADDLE_OCR_MODEL_PATH=      # OCR_ENGINE=paddle_ocr 일 때 필수

# -----------------------------------------------------------------------------
# 번역
# -----------------------------------------------------------------------------
TRANSLATOR_ENGINE=gemini      # gemini | anthropic
GEMINI_API_KEY=               # TRANSLATOR_ENGINE=gemini 일 때 필수
GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=          # TRANSLATOR_ENGINE=anthropic 일 때 필수
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# 파일 저장
# -----------------------------------------------------------------------------
FILE_STORAGE=local            # local | s3 (Phase 2)
FILE_LOCAL_PATH=./storage/files
FILE_URL_PREFIX=/files

# Phase 2 S3 설정 (현재 미사용)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=

# -----------------------------------------------------------------------------
# 스케줄러
# -----------------------------------------------------------------------------
SCHEDULER_AUTO_REPLY_INTERVAL_SECONDS=60   # AI 자동답변 스케줄러 주기
SCHEDULER_COMMENT_FILTER_INTERVAL_SECONDS=300   # 악성 댓글 필터링 스케줄러 주기 (초), 테스트 시 10으로 낮춤
SCHEDULER_COMMENT_FILTER_BATCH_SIZE=20          # 1회 배치 최대 처리 건수

# -----------------------------------------------------------------------------
# 관리자
# -----------------------------------------------------------------------------
# 쉼표 구분. 시드 마이그레이션(seed_initial_admins) 전용 — 해당 이메일의 기존 사용자를
# ADMIN으로 승격. 보안상 로그인 시 이메일 자동 승격은 제거됨. 이후 관리자 지정은
# SYSTEM_ADMIN의 수동 변경으로 일원화. (값 변경 후 alembic upgrade 재실행 필요)
INITIAL_ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# AI 에이전트 (해독이)
# -----------------------------------------------------------------------------
AI_AGENT_USER_ID=USR_00000000
